DATABASE_URL="file:./dev.db"

# Optional. Without this, /api/analyze-event falls back to the deterministic
# alias matcher (lib/extract/baseline.ts) instead of calling a model — the
# endpoint still works, and the UI labels which extractor produced the result.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Pinned rather than an alias like "gemini-flash-latest", so eval
# runs stay reproducible. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
